{
	"name": "mardomingo-backoffice",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24.21.0 <25"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint src tests --no-error-on-unmatched-pattern --max-warnings 0 --concurrency auto && eslint . --ignore-pattern \"src/**\" --ignore-pattern \"tests/**\" --max-warnings 0",
		"lint:changed": "node scripts/lint-changed.mjs",
		"lint:tokens": "node scripts/lint-tokens.mjs",
		"format": "prettier --write .",
		"test": "vitest run --project unit --project component --project integration",
		"test:unit": "vitest run --project unit",
		"test:component": "vitest run --project component",
		"test:int": "vitest run --project integration",
		"test:http": "vitest run --project http",
		"test:related": "vitest related --run",
		"test:coverage": "vitest run --coverage --project unit --project component --project integration",
		"test:trace": "node scripts/test-trace.mjs",
		"test:e2e": "playwright test --project chromium",
		"test:e2e:smoke": "playwright test --project chromium --grep @smoke",
		"test:e2e:critical": "playwright test --project chromium --grep @critical",
		"test:e2e:a11y": "playwright test --project chromium --grep @a11y",
		"test:e2e:visual": "playwright test --project visual",
		"test:e2e:cross-browser": "playwright test --project firefox --project webkit",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --project chromium --headed",
		"test:e2e:debug": "playwright test --project chromium --debug",
		"test:mutation": "stryker run",
		"validate": "pnpm check && pnpm lint && pnpm test:coverage && pnpm build && pnpm test:e2e",
		"db:generate": "drizzle-kit generate",
		"db:check": "drizzle-kit check"
	},
	"dependencies": {
		"better-auth": "1.7.7",
		"better-sqlite3": "13.0.3",
		"croner": "10.0.1",
		"drizzle-orm": "0.45.4",
		"layerchart": "2.6.1",
		"loglevel": "1.9.2",
		"pino": "10.4.0",
		"resend": "6.32.1",
		"zod": "4.6.5",
		"zod-openapi": "6.0.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@fast-check/vitest": "0.5.0",
		"@inlang/paraglide-js": "2.27.0",
		"@inlang/plugin-m-function-matcher": "2.3.0",
		"@inlang/plugin-message-format": "4.5.0",
		"@playwright/test": "1.64.0",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.3",
		"drizzle-kit": "0.31.11",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"fast-check": "4.10.2",
		"globals": "17.13.0",
		"jsdom": "30.1.2",
		"pino-pretty": "13.2.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"sv": "1.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	}
}
