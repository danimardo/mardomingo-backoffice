# Variables de entorno de Cuenta Mardomingo. Este fichero sí se versiona; el `.env` real no.
# Cada variable indica si es SECRETA (no se versiona, va en Coolify) o NO SECRETA.
# Sin ORIGIN: la instancia sirve dos hosts (constitución, «Proxy, puerto e IP del cliente»).
# Los valores de este fichero son ejemplos sin validez: el arranque los rechaza en producción.

# --- Entorno y dominios -------------------------------------------------------------
# development | test | staging | production. NO SECRETA.
APP_ENV=development
# URL pública de la API (api.) y de la web (cuenta.). NO SECRETAS.
PUBLIC_API_URL=http://localhost:5173
PUBLIC_WEB_URL=http://127.0.0.1:5173
# Clave pública de Turnstile. NO SECRETA.
PUBLIC_TURNSTILE_SITE_KEY=
# Puerto y host del proceso dentro del contenedor (producción 7311, staging 7312). NO SECRETAS.
PORT=3000
HOST=0.0.0.0
# Cabeceras que añade Nginx Proxy Manager (un proxy de confianza). NO SECRETAS.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
PROTOCOL_HEADER=x-forwarded-proto
BODY_SIZE_LIMIT=10M

# --- Base de datos y autenticación --------------------------------------------------
# Fichero SQLite (volumen persistente). NO SECRETA.
DATABASE_PATH=./data/app.db
# Secreto de Better Auth. SECRETA.
BETTER_AUTH_SECRET=
# URL base de Better Auth (cuenta.). NO SECRETA.
BETTER_AUTH_URL=http://127.0.0.1:5173
# Email que recibe el rol admin al registrarse y verificarse. NO SECRETA.
ADMIN_EMAIL=
# Clave HMAC para hashes de email (nunca se rota; D-11). SECRETA.
EMAIL_HASH_KEY=

# --- Proveedores de IA --------------------------------------------------------------
# Clave de uso de OpenRouter. SECRETA.
OPENROUTER_API_KEY=
# Clave de gestión para leer el saldo (opcional; sin ella la alerta de saldo queda desactivada). SECRETA.
OPENROUTER_MANAGEMENT_KEY=
# Clave de Mistral (transcripción). SECRETA.
MISTRAL_API_KEY=

# --- Email, captcha y pagos ---------------------------------------------------------
# Clave de Resend. SECRETA.
RESEND_API_KEY=
# Remitente y destino de soporte. NO SECRETA.
EMAIL_FROM="Cuenta Mardomingo <no-reply@mardomingo.com>"
# Secreto de verificación de Turnstile. SECRETA.
TURNSTILE_SECRET=
# En la v4 solo son válidos estos valores. NO SECRETAS.
PAYMENTS_PROVIDER=simulated
INVOICING_PROVIDER=none

# --- Logs ---------------------------------------------------------------------------
# Niveles de pino y de loglevel (el de navegador llega en los datos del layout). NO SECRETAS.
LOG_LEVEL=debug
CLIENT_LOG_LEVEL=debug
# Log Gateway: URL de ingesta y clave de solo escritura del servicio mardomingo_backoffice.
# Obligatorias en staging y producción; ausentes en desarrollo. URL NO SECRETA; clave SECRETA.
LOG_GATEWAY_URL=
LOG_GATEWAY_KEY=

# --- Copias de seguridad (Litestream → Backblaze B2, UE) ----------------------------
# Credenciales de la clave de aplicación limitada a su bucket. SECRETAS.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
