{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"allowJs": true,
		"checkJs": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"tests/**/*.ts",
		"e2e/**/*.ts",
		"*.config.ts",
		"*.config.js",
		"svelte.config.js"
	],
	"exclude": ["Design", "node_modules", "src/lib/paraglide"]
}
