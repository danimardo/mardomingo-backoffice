{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"ask": [
			"Bash(git push *)",
			"PowerShell(git push *)",
			"Bash(gh pr *)",
			"PowerShell(gh pr *)",
			"Bash(gh repo *)",
			"PowerShell(gh repo *)"
		],
		"deny": [
			"Bash(git push --force*)",
			"PowerShell(git push --force*)",
			"Bash(git push -f*)",
			"PowerShell(git push -f*)",
			"Bash(git reset --hard*)",
			"PowerShell(git reset --hard*)",
			"Bash(git clean *)",
			"PowerShell(git clean *)",
			"Read(./.env)",
			"Read(./.env.local)",
			"Read(./.env.production)",
			"Read(./.env.staging)"
		]
	}
}
